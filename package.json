{
  "name": "gabriel-voice-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Donna voice backend with a Portuguese Alexa Skill and OpenAI Realtime client",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "setup": "node scripts/setup.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "prepare:audio": "node --env-file-if-exists=.env scripts/prepare-audio.js",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.js"
  },
  "dependencies": {
    "ask-sdk-express-adapter": "2.14.0",
    "express": "5.2.1",
    "ws": "8.21.3"
  }
}
